{
  "schema_version": "1.0",
  "enabled": true,
  "description": "Stage-aware virtual placement guides for assembly/dismantle video overlays.",
  "default_alpha": 0.3,
  "default_color_bgr": [
    70,
    255,
    90
  ],
  "notes": [
    "target_region values refer to configs/regions_v2.json region_id entries.",
    "square_base and rod_base are projection-only workspace_norm regions and can be retuned with scripts/annotate_region_polygons.py.",
    "Shapes are intentionally simple 2D guides: region_fill, outline, corner_circles, center_circle, capsule, four_rods."
  ],
  "stages": {
    "A01_place_bottom_tie_rod_nuts": {
      "items": [
        {
          "part_label": "bttm_tie_rod_nut",
          "target_region": "square_base",
          "shape": "corner_circles",
          "label": "bottom nuts",
          "radius_px": 10,
          "alpha": 0.38
        }
      ]
    },
    "A02_place_rear_cover": {
      "items": [
        {
          "part_label": "rear_cover",
