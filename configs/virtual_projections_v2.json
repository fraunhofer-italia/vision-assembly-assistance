{
  "schema_version": "2.0",
  "enabled": true,
  "description": "Stage-aware virtual placement guides using top-view sprites rasterized from CAD OBJ meshes.",
  "default_alpha": 0.42,
  "default_color_bgr": [
    70,
    255,
    90
  ],
  "cad_defaults": {
    "projection_axes": [
      "z"
    ],
    "rotate_deg": 90,
    "flip_x": true,
    "flip_y": false,
    "fit_scale": 1.18
  },
  "notes": [
    "This v2 config keeps virtual_projections_v1.json untouched.",
    "shape=cad_top_view warps a CAD-derived transparent top-view sprite into target_region.",
    "shape=cad_corner_instances draws four small CAD sprites at the target region corners.",
    "projection_axes=[z] means the camera looks along CAD z, so CAD z faces the camera.",
    "Use fit_scale > 1.0 to make the CAD guide larger than the base region, or < 1.0 to shrink it.",
    "If a CAD sprite is still rotated or mirrored, tune rotate_deg, flip_x, and flip_y per item."
  ],
  "stages": {
